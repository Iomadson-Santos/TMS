# Copie para backend/.env e substitua todos os valores SEU_ antes de publicar.
APP_NAME=TMS Ciranda
ENVIRONMENT=production
DEBUG=false
PUBLIC_BASE_URL=https://SEU_DOMINIO
ENABLE_API_DOCS=false
ENABLE_API_TOKEN_ENDPOINT=false

# Gere com: ..\.venv\Scripts\python.exe -m app.scripts.generate_secret
SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_DE_64_BYTES
ACCESS_TOKEN_EXPIRE_MINUTES=15
API_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_ROTATION_GRACE_SECONDS=30
SESSION_IDLE_MINUTES=720
SESSION_RETENTION_DAYS=30
MAX_ACTIVE_SESSIONS_PER_USER=5
JWT_ALGORITHM=HS256
JWT_ISSUER=tms-ciranda
JWT_AUDIENCE=tms-web

AUTH_COOKIE_NAME=__Host-tms_session
REFRESH_COOKIE_NAME=__Host-tms_refresh
CSRF_COOKIE_NAME=__Host-tms_csrf
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

LOGIN_MAX_ATTEMPTS=3
LOGIN_IP_MAX_ATTEMPTS=20
LOGIN_LOCK_SECONDS=30
LOGIN_LOCK_MAX_SECONDS=300
LOGIN_ATTEMPT_WINDOW_SECONDS=900
LOGIN_THROTTLE_RETENTION_DAYS=7
PASSWORD_MIN_LENGTH=15

DATABASE_URL=postgresql+psycopg://SEU_USUARIO:SUA_SENHA@127.0.0.1:5432/tms
AUTO_CREATE_TABLES=false

BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_NAME=Administrador TMS
BOOTSTRAP_ADMIN_EMAIL=admin@SEU_DOMINIO
BOOTSTRAP_ADMIN_PASSWORD=SUBSTITUA_POR_UMA_SENHA_TEMPORARIA_FORTE
DEMO_SEED_ENABLED=false

CORS_ORIGINS=https://SEU_DOMINIO
ALLOWED_HOSTS=SEU_DOMINIO
# Em servidor proprio, use FORCE_HTTPS=true. Em plataforma que redireciona no edge,
# use FORCE_HTTPS=false e PLATFORM_HTTPS_ENFORCED=true.
FORCE_HTTPS=true
PLATFORM_HTTPS_ENFORCED=false
HSTS_ENABLED=true
HSTS_MAX_AGE_SECONDS=31536000
HSTS_INCLUDE_SUBDOMAINS=true
MAX_REQUEST_BODY_BYTES=1048576

TRACKING_ONLINE_SECONDS=120
TRACKING_RETENTION_DAYS=90
TRACKING_MIN_INTERVAL_SECONDS=2

LOG_LEVEL=INFO
LOG_TO_STDOUT=true
LOG_FILE=../logs/tms.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=14
BACKUP_DIRECTORY=../backups
BACKUP_RETENTION_DAYS=30
