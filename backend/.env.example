# Ambiente local de desenvolvimento. Nao use este arquivo diretamente em producao.
APP_NAME=TMS Ciranda
ENVIRONMENT=development
DEBUG=false
PUBLIC_BASE_URL=http://127.0.0.1:8000
ENABLE_API_DOCS=true
ENABLE_API_TOKEN_ENDPOINT=true

SECRET_KEY=troque-esta-chave-secreta-por-uma-chave-com-mais-de-48-caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=15
API_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_ROTATION_GRACE_SECONDS=30
SESSION_IDLE_MINUTES=720
SESSION_RETENTION_DAYS=30
MAX_ACTIVE_SESSIONS_PER_USER=5
JWT_ALGORITHM=HS256
JWT_ISSUER=tms-ciranda
JWT_AUDIENCE=tms-web

AUTH_COOKIE_NAME=tms_session
REFRESH_COOKIE_NAME=tms_refresh
CSRF_COOKIE_NAME=tms_csrf
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

LOGIN_MAX_ATTEMPTS=3
LOGIN_IP_MAX_ATTEMPTS=20
LOGIN_LOCK_SECONDS=30
LOGIN_LOCK_MAX_SECONDS=300
LOGIN_ATTEMPT_WINDOW_SECONDS=900
LOGIN_THROTTLE_RETENTION_DAYS=7
PASSWORD_MIN_LENGTH=12

DATABASE_URL=sqlite:///./tms.db
AUTO_CREATE_TABLES=true

BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_NAME=Administrador TMS
BOOTSTRAP_ADMIN_EMAIL=admin@tmsciranda.com.br
BOOTSTRAP_ADMIN_PASSWORD=Admin123!
DEMO_SEED_ENABLED=true

CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
ALLOWED_HOSTS=*
FORCE_HTTPS=false
HSTS_ENABLED=false
HSTS_MAX_AGE_SECONDS=31536000
HSTS_INCLUDE_SUBDOMAINS=true
MAX_REQUEST_BODY_BYTES=1048576

TRACKING_ONLINE_SECONDS=120
TRACKING_RETENTION_DAYS=90
TRACKING_MIN_INTERVAL_SECONDS=2

LOG_LEVEL=INFO
LOG_FILE=
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=14
BACKUP_DIRECTORY=../backups
BACKUP_RETENTION_DAYS=30
